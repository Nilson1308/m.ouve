# API Configuration
# Neste host a 8000 é o SIGA; use a porta do runserver do M.Ouve (ex.: 8765 ou 8870)
VITE_API_BASE_URL=http://127.0.0.1:8765/api/v1
VITE_API_VERSION=v1

# Gov.br OAuth (quando implementado)
VITE_GOVBR_CLIENT_ID=
VITE_GOVBR_REDIRECT_URI=

# Mapbox/Google Maps API (quando implementado)
VITE_MAPS_API_KEY=

# Sentry (monitoramento de erros)
VITE_SENTRY_DSN=

# Feature Flags
VITE_ENABLE_VOICE_INPUT=true
VITE_ENABLE_AI_ASSISTANT=true

# Web Push — mesma Application Server Key do backend (VAPID_PUBLIC_KEY)
VITE_VAPID_PUBLIC_KEY=
