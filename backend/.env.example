SECRET_KEY=change-me-in-production
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,ouvidoria.mogidascruzes.sp.gov.br
CSRF_TRUSTED_ORIGINS=https://ouvidoria.mogidascruzes.sp.gov.br
PUBLIC_BASE_URL=https://ouvidoria.mogidascruzes.sp.gov.br

# Banco dedicado em 192.168.10.49 (PostgreSQL 18 + PostGIS + pgvector)
POSTGRES_DB=ouvia
POSTGRES_USER=admin_ouve
POSTGRES_PASSWORD=altere-apos-criar-no-servidor
POSTGRES_HOST=192.168.10.49
POSTGRES_PORT=5432
# Banco dedicado para `manage.py test` (criar no servidor com extensões postgis + vector)
POSTGRES_TEST_DB=ouvia_test

CELERY_BROKER_URL=redis://127.0.0.1:6379/0
CELERY_RESULT_BACKEND=redis://127.0.0.1:6379/0
# Django cache (cooldown Web Push, etc.) — DB Redis separado do broker Celery
CACHE_REDIS_URL=redis://127.0.0.1:6379/2
# False = LLM do chat via worker; True = síncrono no request (sem Redis)
CELERY_TASK_ALWAYS_EAGER=False

# Com DEBUG=True, localhost/127.0.0.1 em qualquer porta já são liberados por regex no settings.
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,https://ouvidoria.mogidascruzes.sp.gov.br

GOVBR_AUTHORIZE_URL=https://sso.staging.acesso.gov.br/authorize

# Chat LLM — Groq (padrão) ou OpenAI
CHAT_LLM_PROVIDER=groq
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
# IDs variam por conta Groq — liste os seus: GET https://api.groq.com/openai/v1/models
GROQ_CHAT_MODEL=openai/gpt-oss-20b
GROQ_WHISPER_MODEL=whisper-large-v3
# Groq on_demand: limite de tokens de saída por minuto (~1000). Respostas JSON usam pouco.
LLM_CHAT_MAX_TOKENS=768
LLM_CHAT_HISTORICO_LIMITE=14

# Opcional (provider openai ou fallback de chave)
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_CHAT_MODEL=gpt-4o-mini

# Web Push (VAPID) — PWA cidadão
# Gerar: python manage.py generate_vapid -o /caminho/seguro --email mailto:…
# PWA pode obter a pública via GET /api/v1/app/notificacoes/vapid-public-key
VAPID_PUBLIC_KEY=
# Caminho do PEM ou chave privada compacta (web-push)
VAPID_PRIVATE_KEY=
# SMTP (digest SLA, e-mails transacionais) — Gmail: senha de app, host smtp.gmail.com:587
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=

VAPID_ADMIN_EMAIL=mailto:ouvidoria@example.gov.br
# Opcional: URL absoluta no payload push (ex.: https://ouvidoria.municipio.gov.br)
PWA_FRONTEND_BASE_URL=
# Cooldown Web Push por protocolo (segundos, padrão 150)
# PUSH_COOLDOWN_PROTOCOLO_SEGUNDOS=150
